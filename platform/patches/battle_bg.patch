@@ -1,4 +1,7 @@
 #include "global.h"
+#ifdef PLATFORM_WASM
+#include "remake_state.h"
+#endif
 #include "battle.h"
 #include "battle_bg.h"
 #include "battle_main.h"
@@ -759,6 +762,10 @@
 
 void DrawMainBattleBackground(void)
