+extern const struct SpriteTemplate gBasicHitSplatSpriteTemplate;
+extern const struct SpriteTemplate gPersistHitSplatSpriteTemplate;
+extern const struct SpriteTemplate gHandleInvertHitSplatSpriteTemplate;
+extern const struct SpriteTemplate gRandomPosHitSplatSpriteTemplate;
+extern const struct SpriteTemplate gMonEdgeHitSplatSpriteTemplate;
+extern const struct SpriteTemplate gFlashingHitSplatSpriteTemplate;
+extern const struct SpriteTemplate gWaterHitSplatSpriteTemplate;
+void AnimTask_ShakeMon(u8 taskId);
+void AnimTask_ShakeMon2(u8 taskId);
+void AnimTask_ShakeMonInPlace(u8 taskId);
+void AnimTask_ShakeAndSinkMon(u8 taskId);
+void AnimTask_ShakeTargetInPattern(u8 taskId);
+void AnimTask_ShakeTargetBasedOnMovePowerOrDmg(u8 taskId);
+
+static bool8 IsHitSplat(const struct SpriteTemplate *template)
+{
+    return template == &gBasicHitSplatSpriteTemplate || template == &gPersistHitSplatSpriteTemplate
+        || template == &gHandleInvertHitSplatSpriteTemplate || template == &gRandomPosHitSplatSpriteTemplate
+        || template == &gMonEdgeHitSplatSpriteTemplate || template == &gFlashingHitSplatSpriteTemplate
+        || template == &gWaterHitSplatSpriteTemplate;
+}
+
+// A task shaking the foe (its first argument the anim battler it shakes).
+static bool8 ShakesFoe(TaskFunc func, u8 argsCount, const u8 *args)
+{
+    s16 battler = argsCount ? (s16)T1_READ_16(args) : -1;
+    if (func == AnimTask_ShakeTargetInPattern || func == AnimTask_ShakeTargetBasedOnMovePowerOrDmg)
+        return TRUE;
+    if (func == AnimTask_ShakeMon || func == AnimTask_ShakeMon2 || func == AnimTask_ShakeMonInPlace || func == AnimTask_ShakeAndSinkMon)
+        return battler == ANIM_TARGET || battler == ANIM_DEF_PARTNER;
+    return FALSE;
+}
+
+// Whether the commands from `ptr` up to the script's next wait hit the foe
+// (following calls and jumps as the script will). A script without a hit
+// waits at its end, so the battle never goes on before the blow lands.
+static bool8 GroupHitsFoe(const u8 *ptr)
+{
+    const u8 *returns[4];
+    u8 depth = 0;
+    s32 steps;
+
+    for (steps = 0; steps < 128; steps++)
+    {
+        switch (ptr[0])
+        {
+        case 0x02: // createsprite
+            if (IsHitSplat((const struct SpriteTemplate *)T2_READ_32(ptr + 1)))
+                return TRUE;
+            ptr += 7 + 2 * ptr[6];
+            break;
+        case 0x03: // createvisualtask
+            if (ShakesFoe((TaskFunc)T2_READ_32(ptr + 1), ptr[6], ptr + 7))
+                return TRUE;
+            ptr += 7 + 2 * ptr[6];
+            break;
+        case 0x08: // end
+            return TRUE;
+        case 0x0E: // call
+            if (depth == ARRAY_COUNT(returns))
+                return FALSE;
+            returns[depth++] = ptr + 5;
+            ptr = T2_READ_PTR(ptr + 1);
+            break;
+        case 0x0F: // return
+            if (depth == 0)
+                return FALSE;
+            ptr = returns[--depth];
+            break;
+        case 0x11: // choosetwoturnanim
+            ptr = T2_READ_PTR(ptr + ((gAnimMoveTurn & 1) ? 5 : 1));
+            break;
+        case 0x12: // jumpifmoveturn
+            ptr = ptr[1] == gAnimMoveTurn ? T2_READ_PTR(ptr + 2) : ptr + 6;
+            break;
+        case 0x13: // goto
+            ptr = T2_READ_PTR(ptr + 1);
+            break;
+        case 0x06: case 0x07: case 0x0D: case 0x15: case 0x29: case 0x2F:
+            ptr += 1;
+            break;
+        case 0x0A: case 0x0B: case 0x14: case 0x18: case 0x1A: case 0x22: case 0x23:
+        case 0x28: case 0x2A: case 0x2B: case 0x2C: case 0x2D: case 0x2E:
+            ptr += 2;
+            break;
+        case 0x00: case 0x01: case 0x09: case 0x0C: case 0x1E:
+            ptr += 3;
+            break;
+        case 0x10: case 0x19: case 0x25:
+            ptr += 4;
+            break;
+        case 0x24: // jumpifcontest (never in a battle)
+            ptr += 5;
+            break;
+        case 0x1C:
+            ptr += 6;
+            break;
+        case 0x1B: case 0x26: case 0x27:
+            ptr += 7;
+            break;
+        case 0x1F: // createsoundtask
+            ptr += 6 + 2 * ptr[5];
+            break;
+        default: // a delay or a wait: the group ends before any hit
+            return FALSE;
+        }
+    }
+    return FALSE;
+}
+#endif
