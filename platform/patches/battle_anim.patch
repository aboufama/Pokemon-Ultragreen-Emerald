battle_anim.c: the remake layer learns which battle animation runs, and when
a move puts up its own background.

LaunchBattleAnimation starts every battle animation (a move's, a status
condition's, the general and special ones); the remake layer's hook records
the table and the index (the game keeps them in a static it never reads).
LoadMoveBg puts a move's background in the battle background's place (BG3's
map and tiles); the hook records which one, so the remake shows its arena
only while the main background is up.

--- a/src/battle_anim.c
+++ b/src/battle_anim.c
@@ -1,4 +1,7 @@
 #include "global.h"
+#ifdef PLATFORM_WASM
+#include "remake_state.h"
+#endif
 #include "battle.h"
 #include "battle_anim.h"
 #include "battle_controllers.h"
@@ -209,6 +212,11 @@
 {
     s32 i;
 
+#ifdef PLATFORM_WASM
+    // PLATFORM_WASM: the remake layer learns which animation runs.
+    RemakeBattleAnimation(animsTable, tableId, isMoveAnim);
+#endif
+
     if (!IsContest())
     {
         InitPrioritiesForVisibleBattlers();
@@ -1200,6 +1208,10 @@
     }
     else
     {
+#ifdef PLATFORM_WASM
+        // PLATFORM_WASM: the remake layer learns the battle background is a move's.
+        RemakeBattleBackground(bgId);
+#endif
         LZDecompressVram(gBattleAnimBackgroundTable[bgId].tilemap, (void *)BG_SCREEN_ADDR(26));
         LZDecompressVram(gBattleAnimBackgroundTable[bgId].image, (void *)BG_CHAR_ADDR(2));
         LoadCompressedPalette(gBattleAnimBackgroundTable[bgId].palette, BG_PLTT_ID(2), PLTT_SIZE_4BPP);
